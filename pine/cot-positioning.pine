     "29698290,180220,-207563,53.11,-61.17 29708370,181339,-205404,51.49,-58.33 29718450,194019,-221070,52.5,-59.82 29728530,194246,-222282,52.25,-59.79 29738610,186682,-214788,48.65,-55.98 29748690,183910,-213199,47.97,-55.61 29758770,182070,-212309,47.34,-55.2 29768850,197634,-226491,53.19,-60.96 29778930,217940,-252640,54.44,-63.11 29789010,222189,-258418,54.69,-63.61 29799090,243334,-279585,56.86,-65.33 29809170,228124,-264718,54.94,-63.76 29819250,231960,-270274,56.41,-65.72 29829330,230338,-261721,56.19,-63.85 29839410,225853,-262903,54.71,-63.69 29849490,218632,-250967,53.79,-61.75 29859570,210335,-244527,53.1,-61.73 29869650,207879,-242531,52.45,-61.19 29879730,199865,-235582,49.68,-58.56 29889810,186451,-215624,46.99,-54.34")

chunksOf(string m) =>
    switch m
        "EUR" => dEUR()
        "GBP" => dGBP()
        "JPY" => dJPY()
        "CHF" => dCHF()
        "CAD" => dCAD()
        "AUD" => dAUD()
        "NZD" => dNZD()
        "MXN" => dMXN()
        "USD" => dUSD()
        "XAU" => dXAU()
        => array.new<string>()

// ─── Which market ──────────────────────────────────────────────────────────
const string MARKETS = "EUR GBP JPY CHF CAD AUD NZD MXN"
inList(string c) => str.length(c) == 3 and str.contains(MARKETS, c)

rootMarket(string r) =>
    switch r
        "6E" => "EUR"
        "6B" => "GBP"
        "6J" => "JPY"
        "6S" => "CHF"
        "6C" => "CAD"
        "6A" => "AUD"
        "6N" => "NZD"
        "6M" => "MXN"
        "DX" => "USD"
        "GC" => "XAU"
        "MGC" => "XAU"
        => ""

autoMarket() =>
    string base = syminfo.basecurrency
    string quote = syminfo.currency
    string tk = syminfo.ticker
    string fromRoot = rootMarket(syminfo.root)
    string m = ""
    bool flip = false
    if fromRoot != ""
        m := fromRoot
    else if base == "XAU" or str.startswith(tk, "XAU") or str.startswith(tk, "GOLD")
        m := "XAU"
    else if str.startswith(tk, "DXY") or str.startswith(tk, "USDX")
        m := "USD"
    else if inList(base)
        m := base
    else if base == "USD" and inList(quote)
        m := quote
        flip := true
    [m, flip]

pickMarket() =>
    string m = ""
    bool flip = false
    if marketIn == MKT_AUTO
        [am, af] = autoMarket()
        m := am
        flip := af
    else
        m := marketIn == "US dollar index" ? "USD" : marketIn == "Gold" ? "XAU" : marketIn
        flip := syminfo.basecurrency == "USD" and syminfo.currency == m
    [m, flip and pairTerms]

[market, flip] = pickMarket()

nameOf(string m) =>
    switch m
        "EUR" => "Euro FX"
        "GBP" => "British pound"
        "JPY" => "Japanese yen"
        "CHF" => "Swiss franc"
        "CAD" => "Canadian dollar"
        "AUD" => "Australian dollar"
        "NZD" => "New Zealand dollar"
        "MXN" => "Mexican peso"
        "USD" => "US dollar index"
        "XAU" => "Gold"
        => "no market"

// ─── Parse once ────────────────────────────────────────────────────────────
var array<float> tRel = array.new<float>()
var array<float> specNet = array.new<float>()
var array<float> commNet = array.new<float>()
var array<float> specPct = array.new<float>()
var array<float> commPct = array.new<float>()

if barstate.isfirst and market != ""
    array<string> chunks = chunksOf(market)
    for chunk in chunks
        for rec in str.split(chunk, " ")
            array<string> f = str.split(rec, ",")
            if array.size(f) == 5
                array.push(tRel, str.tonumber(array.get(f, 0)) * 60000.0)
                array.push(specNet, str.tonumber(array.get(f, 1)))
                array.push(commNet, str.tonumber(array.get(f, 2)))
                array.push(specPct, str.tonumber(array.get(f, 3)))
                array.push(commPct, str.tonumber(array.get(f, 4)))

// The latest report released by the close of this bar.
var int k = -1
float barEnd = na(time_close) ? time : time_close
while k + 1 < array.size(tRel) and array.get(tRel, k + 1) <= barEnd
    k += 1

float sign = flip ? -1.0 : 1.0
float sNet = k >= 0 ? sign * array.get(specNet, k) : na
float cNet = k >= 0 ? sign * array.get(commNet, k) : na
float sPct = k >= 0 ? sign * array.get(specPct, k) : na
float cPct = k >= 0 ? sign * array.get(commPct, k) : na
float sChange = k >= 1 ? sign * (array.get(specNet, k) - array.get(specNet, k - 1)) : na

bool pctMode = showIn == SHOW_PCT

// ─── Plots ─────────────────────────────────────────────────────────────────
plot(pctMode ? na : sNet, "Net non-commercial", sNet >= 0 ? color.new(specColor, 30) : color.new(specColor, 60), style = plot.style_columns, precision = 0)
plot(pctMode or not showComm ? na : cNet, "Net commercial", commColor, 2, precision = 0)
plot(pctMode ? sPct : na, "Net non-commercial, % of OI", sPct >= 0 ? color.new(specColor, 30) : color.new(specColor, 60), style = plot.style_columns, precision = 2)
plot(pctMode and showComm ? cPct : na, "Net commercial, % of OI", commColor, 2, precision = 2)
hline(0, "Zero", color.new(color.gray, 60))

// ─── Alerts: the speculators' net position crosses zero ─────────────────────
bool flipLong = not na(sNet) and not na(sNet[1]) and sNet > 0 and sNet[1] <= 0
bool flipShort = not na(sNet) and not na(sNet[1]) and sNet < 0 and sNet[1] >= 0
alertcondition(flipLong, "Speculators flip net long", "COT: net non-commercial position crossed above zero (net long)")
alertcondition(flipShort, "Speculators flip net short", "COT: net non-commercial position crossed below zero (net short)")

// ─── The latest report ─────────────────────────────────────────────────────
var table info = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 85), border_width = 1)
if showTable and barstate.islast
    string terms = flip ? " (" + syminfo.ticker + " terms)" : ""
    table.cell(info, 0, 0, nameOf(market) + terms, text_color = chart.fg_color, text_size = size.small)
    if k < 0
        table.cell(info, 0, 1, market == "" ? "Pick a market in the settings" : "No report yet", text_color = chart.fg_color, text_size = size.small)
    else
        float tLast = array.get(tRel, k)
        table.cell(info, 0, 1, "Report of", text_color = chart.fg_color, text_size = size.small)
        table.cell(info, 1, 1, str.format_time(int(tLast) - 3 * 86400000, "yyyy-MM-dd", "America/New_York"), text_color = chart.fg_color, text_size = size.small)
        table.cell(info, 0, 2, "Net speculators", text_color = chart.fg_color, text_size = size.small)
        table.cell(info, 1, 2, str.tostring(sNet, "#,###"), text_color = sNet >= 0 ? color.green : color.red, text_size = size.small)
        table.cell(info, 0, 3, "Change on the week", text_color = chart.fg_color, text_size = size.small)
        table.cell(info, 1, 3, na(sChange) ? "-" : (sChange > 0 ? "+" : "") + str.tostring(sChange, "#,###"), text_color = chart.fg_color, text_size = size.small)
        table.cell(info, 0, 4, "% of open interest", text_color = chart.fg_color, text_size = size.small)
        table.cell(info, 1, 4, na(sPct) ? "-" : str.tostring(sPct, "#.##") + "%", text_color = chart.fg_color, text_size = size.small)
        table.cell(info, 0, 5, "Net commercials", text_color = chart.fg_color, text_size = size.small)
        table.cell(info, 1, 5, str.tostring(cNet, "#,###"), text_color = chart.fg_color, text_size = size.small)
        bool stale = timenow - tLast > 10 * 86400000
        table.cell(info, 0, 6, stale ? "Data ends" : "Data to", text_color = stale ? color.orange : color.gray, text_size = size.tiny)
        table.cell(info, 1, 6, stale ? "2026-10-27: update" : "2026-10-27", text_color = stale ? color.orange : color.gray, text_size = size.tiny)
