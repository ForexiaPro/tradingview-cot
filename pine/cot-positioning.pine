// COT Positioning: the CFTC's Commitments of Traders for the chart's currency or gold:
// net non-commercial (large speculators) and net commercial (hedgers) positions, in
// contracts or as a share of open interest, with the latest report in a table.
//
// The weekly CFTC figures are written into this script as text (Pine reads no files),
// regenerated each week. Data: reports of 2016-01-05 to 2026-10-27.
// Generated from template.pine: edit the template, not the generated file.

//@version=6
indicator("COT Positioning: Speculators and Commercials", shorttitle = "COT Positioning", overlay = false, precision = 2)

// ─── Inputs ────────────────────────────────────────────────────────────────
const string MKT_AUTO = "Auto (from the chart)"
string marketIn = input.string(MKT_AUTO, "Market", options = [MKT_AUTO, "EUR", "GBP", "JPY", "CHF", "CAD", "AUD", "NZD", "MXN", "US dollar index", "Gold"])
const string SHOW_NET = "Net positions (contracts)"
const string SHOW_PCT = "Net as % of open interest"
string showIn = input.string(SHOW_NET, "Show", options = [SHOW_NET, SHOW_PCT])
bool pairTerms = input.bool(true, "In the chart pair's terms", tooltip = "A currency future is quoted against the dollar: long yen futures is short USDJPY. On a chart where the dollar comes first (USDJPY, USDCHF, USDCAD, USDMXN) this turns the positions over.")
bool showComm = input.bool(true, "Show commercials")
bool showTable = input.bool(true, "Show the latest report")
color specColor = input.color(#2962FF, "Non-commercial (speculators)")
color commColor = input.color(#FF9800, "Commercial (hedgers)")

